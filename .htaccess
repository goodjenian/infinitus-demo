# ---------------------------------------------------------------------------
# Infinitus Educacional — regras Apache/LiteSpeed (Hostinger)
# Gerado junto com o site estático. Fonte do mapa: docs/URL-MIGRATION.md
# ---------------------------------------------------------------------------
Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) Canonical: força HTTPS e host sem www (o site antigo tinha canonical em http://)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^(.*)$ https://infinituseducacional.com/$1 [R=301,L]
</IfModule>

# 2) Migração de URLs — WordPress antigo -> site novo (301 permanente)
# Cursos (LearnPress /courses/...) -> páginas por ÁREA
Redirect 301 /courses/segunda-licenciatura-em-pedagogia/ /cursos/pedagogia/
Redirect 301 /courses/segunda-licenciatura-em-letras-portugues/ /cursos/letras-ingles-portugues/
Redirect 301 /courses/r2-letras-ead/ /cursos/letras-ingles-portugues/
Redirect 301 /courses/segunda-licenciatura-em-matematica/ /cursos/matematica/
Redirect 301 /courses/r2-matematica-ead/ /cursos/matematica/
Redirect 301 /courses/segunda-licenciatura-em-artes-visuais/ /cursos/artes-visuais/
Redirect 301 /courses/r2-artes-visuais-ead/ /cursos/artes-visuais/
Redirect 301 /courses/segunda-licenciatura-em-educacao-fisica/ /cursos/educacao-fisica/
Redirect 301 /courses/r2-educacao-fisica-ead/ /cursos/educacao-fisica/
Redirect 301 /courses/pos-graduacao-em-gestao-escolar/ /cursos/pos-graduacao/
RedirectMatch 301 ^/courses/?$ /cursos/

# Hubs e páginas institucionais antigas
Redirect 301 /cursos-ead/ /cursos/
Redirect 301 /graduacao-ead/ /cursos/#licenciatura
Redirect 301 /segunda-licenciatura/ /cursos/#segunda-graduacao
Redirect 301 /pos-graduacao-ead/ /cursos/pos-graduacao/
Redirect 301 /formacao-continuada-de-professores/ /cursos/
Redirect 301 /especializacao-em-educacao/ /cursos/pos-graduacao/
Redirect 301 /curso-para-professores-de-educacao-infantil/ /cursos/pedagogia/
Redirect 301 /cursos-para-professores/ /cursos/
Redirect 301 /cursos-de-capacitacao-para-professores/ /cursos/
Redirect 301 /o-que-e-ensino-a-distancia/ /sobre/
Redirect 301 /inscreva-se/ /contato/
Redirect 301 /inscreva-se/obrigado/ /contato/
Redirect 301 /contato/obrigado/ /contato/
Redirect 301 /area-do-aluno/ https://infinitus.curso.study/metodo/login.php
Redirect 301 /certificacao/fap-faculdade-parana-cambe/ /sobre/
Redirect 301 /certificacao/faep-faculdade-de-educacao-paulistana/ /sobre/

# Restos do WordPress/WooCommerce/LearnPress sem equivalente: home (301) — não 404 em massa
Redirect 301 /shop/ /
Redirect 301 /instructors-2/ /
Redirect 301 /lp-checkout/ /
Redirect 301 /lost-password/ /
Redirect 301 /sitemap_index.xml /sitemap.xml
Redirect 301 /wp-sitemap.xml /sitemap.xml

# 3) Páginas de erro
ErrorDocument 404 /404.html

# 4) Cache e compressão
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|webp|png|jpg|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/xml image/svg+xml
</IfModule>
